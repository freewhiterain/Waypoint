# 应用
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=18000
DEBUG=false
JWT_SECRET_KEY=请替换为独立的高强度随机密钥
TRAVEL_AGENT_MODE=supervisor_subagents
ALLOW_LEGACY_FALLBACK=false
ENABLE_EXTERNAL_TOOLS=false
# 逗号分隔；浏览器直接访问 /ui 时必须包含实际访问用的 host:port
CORS_ORIGINS=http://localhost:18000,http://127.0.0.1:18000

# 模型（OpenAI 兼容接口，换供应商只改这几项，不动代码）
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com
# DeepSeek 的 thinking 模式不支持强制 tool_choice，而结构化输出正是靠它。
# 关掉才能让路由 / 需求抽取 / Worker 分析 / 行程合成拿到结构化结果。
# 换用支持 json_schema 的供应商时可以设为 false。
LLM_DISABLE_THINKING=true

# Embedding（本地 Ollama，与 LLM 供应商解耦，不需要外部 Key）
# 需先启动 Ollama 并 ollama pull qwen3-embedding:4b
EMBEDDING_BASE_URL=http://127.0.0.1:11434/v1
EMBEDDING_MODEL=qwen3-embedding:4b
# 追踪需要 LANGSMITH_TRACING=true 且 LANGSMITH_API_KEY 非空，缺一不开
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=zhixing-travel-planner-dev
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# PostgreSQL / Redis
# 端口按本机 docker 映射填写（README 的 docker run 用的是 5432 / 6379）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_travel_db
POSTGRES_USER=travel_user
POSTGRES_PASSWORD=travel123456
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 只读实时数据源
AMAP_API_KEY=
TAVILY_API_KEY=
MCP_WEATHER_URL=
MCP_SEARCH_URL=
EXTERNAL_TIMEOUT_SECONDS=10
EXTERNAL_MAX_RETRIES=2
# 以下两项目前还没有代码读取（app/config.py 未声明对应字段），
# 预留给后续航班 / 酒店 MCP 接入，填了也暂时不会生效。
VARIFLIGHT_API_KEY=
AIGOHOTEL_MCP_API=

# RAG 检索
# 交叉编码器重排需要额外下载模型，见 README「CrossEncoder 重排」
ENABLE_CROSS_ENCODER_RERANK=false
CROSS_ENCODER_MODEL=BAAI/bge-reranker-base
